{
  "name": "focus-screen",
  "productName": "Focus Screen",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Music, a combined to-do list and a focus timer on your second monitor",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:extension": "tsc --noEmit -p tsconfig.extension.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && npm run build:reminders && npm run build:audio && electron-builder --mac -c.directories.output=\"$HOME/Library/Developer/FocusScreen/dist\"",
    "build:win": "npm run build && electron-builder --win",
    "build:extension": "node extension/build.mjs",
    "build:reminders": "sh native/mac-reminders/build.sh",
    "build:safari": "npm run build:extension && sh native/safari-extension/install.sh",
    "build:icons": "electron scripts/build-icons.mjs",
    "build:audio": "sh native/mac-audio/build.sh",
    "install:mac": "node scripts/install-mac.mjs",
    "setup:aligner": "sh native/aligner/setup.sh",
    "setup:covers": "sh native/cover-motion/setup.sh"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "kuromoji": "0.1.2",
    "ws": "^8.22.0"
  }
}
